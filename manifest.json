{
  "manifest_version": 3,
  "name": "Readwise Reader - YouTube Auto-Liker",
  "version": "1.0.0",
  "description": "Automatically opens archived YouTube videos from Readwise Reader, likes them on YouTube, and tags them as 'liked'.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Readwise YouTube Auto-Liker"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "readwise-youtube-liker@local",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://readwise.io/*",
    "https://*.youtube.com/*",
    "https://read.readwise.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "inject_visibility.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube_content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://read.readwise.io/*"
      ],
      "js": [
        "reader_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}